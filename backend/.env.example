# Copy to .env and fill in. App runs without these (mock script + browser voice),
# but real narration/audio need them.
ANTHROPIC_API_KEY=
# Cartesia powers text-to-speech, the per-artist voice palette, and speech-to-text.
CARTESIA_API_KEY=
# Optional: pin a default Cartesia voice id (UUID). Blank = auto-pick from your voices.
CARTESIA_VOICE_ID=
